        <mxCell id="e23" value="identity_error" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#DC2626;dashed=1;" edge="1" parent="1" source="decision" target="identity_errors"><mxGeometry relative="1" as="geometry"/></mxCell>
