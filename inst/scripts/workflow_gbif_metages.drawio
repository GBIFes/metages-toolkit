<mxfile host="app.diagrams.net" modified="2026-08-28T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" compressed="false">
  <diagram id="workflow-final" name="Workflow definitivo">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="GBIF España → detección → extracción común → altas, actualizaciones y visibilidad" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="100" y="20" width="2000" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Un workflow R · una tabla nueva para altas · visibilidad integrada en metages_recurso_monitor_sync()" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="100" y="65" width="2000" height="30" as="geometry"/></mxCell>

        <mxCell id="r_lane" value="R · CONSULTA Y NORMALIZACIÓN" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#DBEAFE;swimlaneFillColor=#EFF6FF;strokeColor=#3B82F6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="2120" height="420" as="geometry"/></mxCell>
        <mxCell id="db_lane" value="MYSQL · ESTADO PREPARADO" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#FEF3C7;swimlaneFillColor=#FFFBEB;strokeColor=#F59E0B;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="2120" height="300" as="geometry"/></mxCell>
        <mxCell id="sql_lane" value="MYSQL · DRY-RUN Y APPLY CONTROLADOS" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#EDE9FE;swimlaneFillColor=#F5F3FF;strokeColor=#8B5CF6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="2120" height="390" as="geometry"/></mxCell>
        <mxCell id="legacy_lane" value="REUTILIZACIÓN Y TRAZABILIDAD" style="swimlane;html=1;horizontal=0;startSize=34;fillColor=#DCFCE7;swimlaneFillColor=#F0FDF4;strokeColor=#22C55E;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="2120" height="190" as="geometry"/></mxCell>

        <mxCell id="run" value="&lt;b&gt;[PÚBLICA] run_gbif_spain_workflow()&lt;/b&gt;&lt;br&gt;Orquesta inventario, comparación y preparación.&lt;br&gt;write=FALSE: solo lectura · write=TRUE: monitores.&lt;br&gt;.gbif_load_metages_resources(): baseline por MAX(provision_id)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="180" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="inventory" value="&lt;b&gt;[PÚBLICA] fetch_gbif_spain_inventory()&lt;/b&gt;&lt;br&gt;.gbif_paginate() · .gbif_fetch_dataset_details() · .gbif_extract_dataset_endpoints() · .gbif_dataset_rows()&lt;br&gt;Detalle raw + relaciones + endpoints DWC_ARCHIVE/EML." style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="370" height="165" as="geometry"/></mxCell>
        <mxCell id="match" value="&lt;b&gt;Correspondencia determinista&lt;/b&gt;&lt;br&gt;.gbif_safe_dataset_uuid() · .gbif_resource_uuid() · .gbif_resource_uuids() · .gbif_resource_match_index()&lt;br&gt;UUID → url_gbiforg → url_ipt; cuenta públicos y privados por separado; nunca usa título. Los no resolubles se excluyen sin detener el run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="165" width="350" height="135" as="geometry"/></mxCell>
        <mxCell id="unresolved" value="&lt;b&gt;result$unresolved_resources&lt;/b&gt;&lt;br&gt;Recursos MetaGES sin UUID GBIF resoluble; conserva el error y el motivo de exclusión.&lt;br&gt;No entra en matching, extracción, disponibilidad ni escrituras." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="405" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="decision" value="&lt;b&gt;Clasificación por UUID&lt;/b&gt;&lt;br&gt;0 coincidencias: missing&lt;br&gt;1 público: existing&lt;br&gt;solo privados: existing_private&lt;br&gt;≥2 públicos: identity_error" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="155" width="255" height="155" as="geometry"/></mxCell>
        <mxCell id="incremental" value="&lt;b&gt;.gbif_is_due()&lt;/b&gt;&lt;br&gt;Existente: extraer si modified &gt; last_checked, nunca comprobado, &gt;30 días, error previo o force_full." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1620" y="145" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="availability" value="&lt;b&gt;.gbif_probe_dataset()&lt;/b&gt;&lt;br&gt;.gbif_availability_transition()&lt;br&gt;/dataset/{uuid}: deleted; 404/410; fuera de ES; error temporal; reaparición." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="275" width="350" height="105" as="geometry"/></mxCell>
        <mxCell id="type_map" value="&lt;b&gt;.gbif_type_to_metages()&lt;/b&gt;&lt;br&gt;OCCURRENCE→223 · SAMPLING_EVENT→224&lt;br&gt;CHECKLIST→225 · METADATA→226" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="350" width="390" height="90" as="geometry"/></mxCell>
        <mxCell id="extract" value="&lt;b&gt;[INTERNA] .gbif_extract_dataset_metadata()&lt;/b&gt;&lt;br&gt;Una sola llamada con nuevos + existentes seleccionados.&lt;br&gt;&lt;b&gt;Única dueña del conteo y fallback DwC-A; lógica existente consolidada.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="340" width="450" height="110" as="geometry"/></mxCell>
        <mxCell id="compare" value="&lt;b&gt;[INTERNA] .gbif_compare_resource_snapshot()&lt;/b&gt;&lt;br&gt;Compara título, fecha, versión y conteo de recursos existentes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1490" y="420" width="360" height="85" as="geometry"/></mxCell>

        <mxCell id="new_table" value="&lt;b&gt;.gbif_reconcile_new_candidates() + .gbif_upsert_new_candidates()&lt;/b&gt;&lt;br&gt;Retira del staging UUID que ya existen en MetaGES y escribe en metages_recurso_monitor_nuevos exclusivamente datasets missing; metadatos, publisher, extracción y revisión final." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="610" width="440" height="135" as="geometry"/></mxCell>
        <mxCell id="identity_errors" value="&lt;b&gt;result$identity_errors&lt;/b&gt;&lt;br&gt;UUID compartido por ≥2 recursos públicos MetaGES; enumera recurso_id y añade datos GBIF España si existen.&lt;br&gt;Nunca entra en extracción ni staging." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="750" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="review" value="&lt;b&gt;Revisión SQL manual&lt;/b&gt;&lt;br&gt;pending → approved/rejected&lt;br&gt;La aprobación es definitiva, pero no evita validaciones técnicas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="640" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="monitor" value="&lt;b&gt;.gbif_upsert_monitor_content() + .gbif_upsert_availability()&lt;/b&gt;&lt;br&gt;Escriben contenido, disponibilidad, visibilidad y endpoints detectados.&lt;br&gt;El SQL solo añade url_ipt/url_eml si el destino está vacío; nunca sobrescribe." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="615" width="480" height="135" as="geometry"/></mxCell>
        <mxCell id="monitor_log" value="&lt;b&gt;.gbif_insert_monitor_log()&lt;/b&gt;&lt;br&gt;Conserva en monitor_log los eventos históricos de contenido ya implementados." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1720" y="640" width="300" height="90" as="geometry"/></mxCell>

        <mxCell id="new_proc" value="&lt;b&gt;metages_recurso_monitor_nuevos_sync() · v011&lt;/b&gt;&lt;br&gt;Dry-run/apply para altas approved. Valida identidad y body_id=1170." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="930" width="410" height="100" as="geometry"/></mxCell>
        <mxCell id="new_resource" value="&lt;b&gt;Alta atómica&lt;/b&gt;&lt;br&gt;metages_recurso: body_fk=1170, private=0, institucion_fk=NULL&lt;br&gt;+ provisión inicial&lt;br&gt;created_who = procedimiento" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="920" width="390" height="120" as="geometry"/></mxCell>
        <mxCell id="sync" value="&lt;b&gt;[EXISTENTE AMPLIADO] metages_recurso_monitor_sync()&lt;/b&gt;&lt;br&gt;Misma firma. Un plan, un GET_LOCK, snapshots y una transacción.&lt;br&gt;No existe procedimiento de visibility separado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="915" width="480" height="125" as="geometry"/></mxCell>
        <mxCell id="sync_decision" value="Acción planificada" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1710" y="920" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="content_action" value="&lt;b&gt;Contenido&lt;/b&gt;&lt;br&gt;Nueva provisión y actualización de título/conteo/versión según reglas actuales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="1090" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="private_action" value="&lt;b&gt;Visibilidad&lt;/b&gt;&lt;br&gt;review_private → private=1&lt;br&gt;review_public → private=0&lt;br&gt;Solo con p_actualizar_recursos=1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="1090" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="atomic" value="&lt;b&gt;Garantía común&lt;/b&gt;&lt;br&gt;Snapshot previo + updated_who + idempotencia + rollback completo. Nunca DELETE en metages_recurso." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1880" y="1090" width="230" height="90" as="geometry"/></mxCell>

        <mxCell id="trace1" value="&lt;b&gt;extraer_metadata_gbif.R [ELIMINADO]&lt;/b&gt;&lt;br&gt;Paginación, publishers y raw pasan a fetch_gbif_spain_inventory(); desaparece el HTTP paralelo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="1320" width="390" height="80" as="geometry"/></mxCell>
        <mxCell id="trace2" value="&lt;b&gt;comparar_datasets_gbiforg_metages.R [ELIMINADO]&lt;/b&gt;&lt;br&gt;Matching y resumen pasan a run_gbif_spain_workflow(write=FALSE, force_full=TRUE)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="1320" width="410" height="80" as="geometry"/></mxCell>
        <mxCell id="trace3" value="&lt;b&gt;R/extraer_metadatos_gbif_de_recursos_metages.R [CONSOLIDADO]&lt;/b&gt;&lt;br&gt;R/gbif_client.R: .gbif_api_perform/get_json/get_xml · .gbif_extract_version · .gbif_dataset_uuid · .gbif_ipt_resource_key · .gbif_normalize_endpoint · .gbif_dwca_endpoint · .gbif_zip_entry · .gbif_count_dwca_row_type · .gbif_fallback_row_type · .gbif_dataset_key_from_dwca.&lt;br&gt;Extractor/comparador pasan a internos. API final: fetch_gbif_spain_inventory() + run_gbif_spain_workflow()." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="1300" width="520" height="125" as="geometry"/></mxCell>
        <mxCell id="trace4" value="&lt;b&gt;Migración de esquema&lt;/b&gt;&lt;br&gt;metages_recurso.institucion_fk pasa a NULLABLE antes de las altas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1630" y="1320" width="390" height="80" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="run" target="inventory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2563EB;" edge="1" parent="1" source="inventory" target="match"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2563EB;" edge="1" parent="1" source="match" target="decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="decision" target="type_map"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="sí" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2563EB;" edge="1" parent="1" source="decision" target="incremental"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="ausente del inventario" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="decision" target="availability"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#15803D;strokeWidth=2;" edge="1" parent="1" source="type_map" target="extract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="seleccionados" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#15803D;strokeWidth=2;" edge="1" parent="1" source="incremental" target="extract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="nuevos" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="extract" target="new_table"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="existentes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#16A34A;" edge="1" parent="1" source="extract" target="compare"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="compare" target="monitor"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="disponibilidad" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="availability" target="monitor"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="new_table" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="approved" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7C3AED;" edge="1" parent="1" source="review" target="new_proc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="dry-run / apply" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7C3AED;strokeWidth=2;" edge="1" parent="1" source="new_proc" target="new_resource"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D97706;" edge="1" parent="1" source="monitor" target="monitor_log"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="dry-run / apply" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7C3AED;strokeWidth=2;" edge="1" parent="1" source="monitor" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7C3AED;" edge="1" parent="1" source="sync" target="sync_decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="contenido" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7C3AED;" edge="1" parent="1" source="sync_decision" target="content_action"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="visibilidad" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#7C3AED;" edge="1" parent="1" source="sync_decision" target="private_action"><mxGeometry relative="1" as="geometry"/></mxCell>
